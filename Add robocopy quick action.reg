Windows Registry Editor Version 5.00

; ┌───────────────────────────────────────────────────────────────────┐
; │              ADK Custom Robocopy Right-Click Actions              │
; │                                                                   │
; │ These entries add “Copy (Robocopy Source)” and “Paste (Robocopy)” │
; │        options to the context menus for files and folders.        │
; │              They require holding SHIFT to appear.                │
; └───────────────────────────────────────────────────────────────────┘

; ┌───────────────── Robocopy Source (Copy) Action ───────────────────┐
; │                                                                   │
; │     Adds “Copy (Robocopy)” to the right-click menu for Files.     │
; │   Requires SHIFT key to appear because of the “Extended” value.   │
; └───────────────────────────────────────────────────────────────────┘

[HKEY_CLASSES_ROOT\*\shell\ADK-RobocopySourceCopy]
@="Copy (Robocopy)"
"Icon"="shell32.dll,134" ; Optional: Uses a standard copy icon
"Extended"="" ; <--- Hide the option unless you hold SHIFT while right-clicking (makes menus less cluttered)

[HKEY_CLASSES_ROOT\*\shell\ADK-RobocopySourceCopy\command]
; This command writes the full path of the selected file/folder to a temporary file.
; Using a subfolder “\ADK” in %TEMP% environment variable.
; This PowerShell command does the following:
; 1. Defines the temporary folder path (%TEMP%\ADK).
; 2. Checks if the temporary folder exists and creates it if not.
; 3. Takes the selected item's path (%L) and writes it to “robocopy_source_path.txt” in the temporary folder.
; 4. Uses UTF8 encoding without a Byte Order Mark (BOM).
; 5. Suppresses output using Out-Null.
@="pwsh -NoProfile -Command \"$temp_folder_path = \\\"${Env:TEMP}\\ADK\\\"; if (-not (Test-Path -LiteralPath $temp_folder_path -PathType \\\"Container\\\")) { New-Item -ItemType \\\"Directory\\\" -Path $temp_folder_path | Out-Null }; \\\"%L\\\" | Out-File -LiteralPath \\\"${temp_folder_path}\\robocopy_source_path.txt\\\" -Encoding \\\"utf8NoBOM\\\" | Out-Null\""

; Adds “Copy (Robocopy)” to the right-click menu for Folders
; Requires SHIFT key to appear because of the “Extended” value

[HKEY_CLASSES_ROOT\Directory\shell\ADK-RobocopySourceCopy]
@="Copy (Robocopy)"
"Icon"="shell32.dll,134" ; Optional: Uses a standard copy icon (or change to 4 for folder)
"Extended"="" ; <--- Hide the option unless you hold SHIFT while right-clicking (makes menus less cluttered)

[HKEY_CLASSES_ROOT\Directory\shell\ADK-RobocopySourceCopy\command]
; This command does the same thing as above, saving the selected folder's path.
@="pwsh -NoProfile -Command \"$temp_folder_path = \\\"${Env:TEMP}\\ADK\\\"; if (-not (Test-Path -LiteralPath $temp_folder_path -PathType \\\"Container\\\")) { New-Item -ItemType \\\"Directory\\\" -Path $temp_folder_path | Out-Null }; \\\"%L\\\" | Out-File -LiteralPath \\\"${temp_folder_path}\\robocopy_source_path.txt\\\" -Encoding \\\"utf8NoBOM\\\" | Out-Null\""


; ┌─────────────── Robocopy Destination (Paste) Action ───────────────────┐
; │                                                                       │
; │ Adds “Paste (Robocopy)” to the right-click menu when you right-click  │
; │    in the background of a folder window (the “paste” destination).    │
; │     Requires SHIFT key to appear because of the “Extended” value.     │
; └───────────────────────────────────────────────────────────────────────┘

[HKEY_CLASSES_ROOT\Directory\Background\shell\ADK-RobocopyPaste]
@="Paste (Robocopy)"
"Icon"="shell32.dll,260" ; Optional: Uses a standard paste icon
"Extended"="" ; <--- Hide the option unless you hold SHIFT while right-clicking (makes menus less cluttered)

[HKEY_CLASSES_ROOT\Directory\Background\shell\ADK-RobocopyPaste\command]
; This command reads the source path from the temporary file, gets the destination path,
; and then runs robocopy with the specified parameters.
; PowerShell command breakdown:
; `pwsh -NoProfile -Command "..."` : Executes a PowerShell command without loading the user profile.
; `$item_list_file_path = \"${Env:TEMP}\\ADK\\robocopy_source_path.txt\\\"` : Sets a variable for the temporary source file path.
; `if (Test-Path -LiteralPath $item_list_file_path -PathType \"Leaf\") { ... } else { ... }` : Checks if the source file exists.
; `Write-Host \\\"Copy files first.\\\" -ForegroundColor \\\"Red\\\"` : Displays an error if the source file is not found.
; `cmd /c \\\"pause\\\"\"` : Pauses the command prompt window at the end.
; `$item_paths = Get-Content -LiteralPath $item_list_file_path -Encoding \\\"utf8NoBOM\\\"` : Reads source path(s) from the temporary file.
; `foreach ($path in $item_paths) { ... }` : Loops through each source path (usually just one).
; `if ((Get-Item -LiteralPath $path).PSIsContainer) { ... } else { ... }` : Checks if the source path is a directory or file.
; --- Robocopy command for Directories ---
; `robocopy \\\"$path\\\" \\\"%V\\$( Split-Path -Path $path -Leaf )\\\" \\\"*.*\\\" /E /COPY:DAT /DCOPY:DAT /SJ /SL /R:2 /W:5 /XO /XC /V /TS /FP /TEE /UNICODE /ETA`
; `robocopy` : The Robocopy command.
; `\\\"$path\\\"` : Source directory path.
; `\\\"%V\\$( Split-Path -Path $path -Leaf )\\\"` : Destination directory path (%V is the paste destination, Split-Path gets the source folder name).
; `\\\"*.*\\\"` : Files to copy (all files).
; `/E` : Copy subdirectories, including empty ones.
; `/COPY:DAT` : Copy Data, Attributes, Timestamps.
; `/DCOPY:DAT` : Copy Data, Attributes, Timestamps for directories.
; `/SJ` : Skip Junction points.
; `/SL` : Copy symbolic links.
; `/R:2` : Retry failed copies 2 times.
; `/W:5` : Wait 5 seconds between retries.
; `/XO` : Exclude older files (copy newer/changed).
; `/XC` : Exclude identical files (copy newer/changed).
; `/V` : Verbose output.
; `/TS` : Include source timestamps in output.
; `/FP` : Include full path of files in output.
; `/TEE` : Output to console.
; `/UNICODE` : Output as Unicode.
; `/ETA` : Show Estimated Time of Arrival.
; --- Robocopy command for Files ---
; `robocopy \\\"$( Split-Path -Path $path -Parent )\\\" \\\"%V\\\" \\\"$( Split-Path -Path $path -Leaf )\\\" /E /COPY:DAT /DCOPY:DAT /SJ /SL /R:2 /W:5 /XO /XC /V /TS /FP /TEE /UNICODE /ETA /XF \\\"*.*\\\" /XD \\\"*.*\\\"`
; `robocopy` : The Robocopy command.
; `\\\"$( Split-Path -Path $path -Parent )\\\"` : Source directory path (parent of the selected file).
; `\\\"%V\\\"` : Destination directory path (%V is the paste destination).
; `\\\"$( Split-Path -Path $path -Leaf )\\\"` : Specific file to copy.
; `/E /COPY:DAT /DCOPY:DAT /SJ /SL /R:2 /W:5 /XO /XC /V /TS /FP /TEE /UNICODE /ETA` : Same options as for directories.
; `/XF \\\"*.*\\\"` : Exclude all files.
; `/XD \\\"*.*\\\"` : Exclude all directories.
; `Remove-Item -LiteralPath $item_list_file_path` : Deletes the temporary source file.
@="pwsh -NoProfile -Command \"$item_list_file_path = \\\"${Env:TEMP}\\ADK\\robocopy_source_path.txt\\\"; if (Test-Path -LiteralPath $item_list_file_path -PathType \\\"Leaf\\\") { $item_paths = Get-Content -LiteralPath $item_list_file_path -Encoding \\\"utf8NoBOM\\\"; foreach ($path in $item_paths) { if ((Get-Item -LiteralPath $path).PSIsContainer) { robocopy \\\"$path\\\" \\\"%V\\$( Split-Path -Path $path -Leaf )\\\" \\\"*.*\\\" /E /COPY:DAT /DCOPY:DAT /SJ /SL /R:2 /W:5 /XO /XC /V /TS /FP /TEE /UNICODE /ETA } else { robocopy \\\"$( Split-Path -Path $path -Parent )\\\" \\\"%V\\\" \\\"$( Split-Path -Path $path -Leaf )\\\" /E /COPY:DAT /DCOPY:DAT /SJ /SL /R:2 /W:5 /XO /XC /V /TS /FP /TEE /UNICODE /ETA /XF \\\"*.*\\\" /XD \\\"*.*\\\" } }; Remove-Item -LiteralPath $item_list_file_path } else { Write-Host \\\"Copy files first.\\\" -ForegroundColor \\\"Red\\\" }; cmd /c \\\"pause\\\"\""
