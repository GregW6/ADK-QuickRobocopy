Windows Registry Editor Version 5.00

; ┌─────────────────────────────────────────────────────────────────┐
; │          Remove ADK Custom Robocopy Right-Click Actions         │
; │                                                                 │
; │  This file removes the “Copy (Robocopy)” and “Paste (Robocopy)” │
; │   context menu entries added by the corresponding “Add” file.   │
; └─────────────────────────────────────────────────────────────────┘

; Remove Copy (Robocopy) for Files
[-HKEY_CLASSES_ROOT\*\shell\ADK-RobocopySourceCopy]

; Remove Copy (Robocopy) for Folders
[-HKEY_CLASSES_ROOT\Directory\shell\ADK-RobocopySourceCopy]

; Remove Paste (Robocopy) for Folder Backgrounds
[-HKEY_CLASSES_ROOT\Directory\Background\shell\ADK-RobocopyPaste]

; Remove Cancel Copy (Robocopy) for Folder Backgrounds
[-HKEY_CLASSES_ROOT\Directory\Background\shell\ADK-RobocopyCancelCopy]
